{"id":"beats-f2c913","type":"CREATE","payload":{"description":"It would be great if we could show info about the current user looking at the Beats board (i.e., the user identity that will be used to store changes to the issues.db) on the left-hand side of the bottom status bar. Show Avatar + Name","labels":["feature"],"sort_order":"a9","title":"Show current user in footer"},"created_at":"2026-05-31T08:04:21.825157Z","created_by":"Nicolas Bettenburg \u003cnicbet@gmail.com\u003e"}
