{"id":"beats-fd45c2","type":"CREATE","payload":{"title":"Text in input element stays muted","description":"When editing an issue description or leaving a comment, the text typed by a user appears in the muted placeholder/help hint style rather than our primary light text style","labels":["bug"]},"created_at":"2026-05-20T04:49:24.746631Z","created_by":"Nicolas Bettenburg \u003cnicbet@gmail.com\u003e"}
{"id":"beats-05e0dd","type":"CREATE","payload":{"title":"Different text styles for input boxes","description":"The \"create new issue\" dialog has a \"secondary\" text size (13px) for the description text vs title (15px). The UI uses \"lg\" for title (18px) and regular (15px) for description","labels":["bug"]},"created_at":"2026-05-20T04:51:37.055979Z","created_by":"Nicolas Bettenburg \u003cnicbet@gmail.com\u003e"}
{"id":"beats-b318b3","type":"CREATE","payload":{"title":"Arrow key navigation / selection broken in CMD palette","description":"Cannot use arrow keys to select from the shown options in the command palette after entering a search text, for example, for an issue title.","labels":["bug"]},"created_at":"2026-05-20T04:52:43.099024Z","created_by":"Nicolas Bettenburg \u003cnicbet@gmail.com\u003e"}
