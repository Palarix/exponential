#!/usr/bin/env bash
#
# Pre-commit: run make lint (go vet + eslint) on staged changes.
# Skips if no relevant files are staged.
#

STAGED=$(git diff --cached --name-only --diff-filter=ACM)

HAS_GO=$(echo "$STAGED" | grep -qE '\.go$' && echo 1 || true)
HAS_FE=$(echo "$STAGED" | grep -qE '^web/.*\.(ts|tsx|js|jsx)$' && echo 1 || true)

if [ -n "$HAS_GO" ] || [ -n "$HAS_FE" ]; then
  echo "pre-commit: running make lint..."
  if ! make lint; then
    echo "error: make lint failed"
    exit 1
  fi
fi
