{"id":"xpo-d918bd","type":"COMMENT","payload":{"id":"cmt-8f2541da-f13d-4ca5-bf0d-49c0e13f7c8b","text":"Tuned `PointerSensor` activation distance from `5` → `3` to make drag feedback feel more immediate while still filtering accidental drags when clicking popover triggers inside rows. Approved."},"created_at":"2026-05-27T13:26:48.716201253Z","on_behalf_of":"Nicolas Bettenburg <nicbet@gmail.com>","created_by":"claude-code/2.1.152 \u003cagent@mcp\u003e"}
