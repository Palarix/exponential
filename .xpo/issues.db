{"id":"xpo-caabc6","type":"CREATE","payload":{"title":"Update sub-issues dialog should have scrollable issue list","description":"Currently all sub-issues under a parent are shown, for large epics this list is long and makes the dialog fill beyond screen height. Instead, the issue list should be scrollable, height sufficient to display 4 at a time.","sort_order":"bI6","labels":["improvement"]},"created_at":"2026-07-15T05:38:18.924716Z","created_by":"Nicolas Bettenburg \u003cnicbet@gmail.com\u003e","source":"web"}
