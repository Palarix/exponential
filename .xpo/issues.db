{"id":"xpo-bbd43a","type":"CREATE","payload":{"description":"An aborted drag-drop in the web UI set an issue as its own parent (`parent_id == id`), hiding it from the board. The backend should reject self-referencing parent assignments in UpdateIssue, and the frontend should not emit a parent update on aborted drags.","estimate":1,"labels":["bug"],"status":"BACKLOG","title":"Guard against self-referencing parent_id"},"created_at":"2026-06-21T16:49:15.636988Z","on_behalf_of":"Nicolas Bettenburg <nicbet@gmail.com>","created_by":"claude-code/2.1.185 \u003cagent@mcp\u003e"}
