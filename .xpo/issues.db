{"id":"xpo-6598d3","type":"CREATE","payload":{"description":"Epic for code review capabilities — review comments, dedicated reviewer agent, configurable review flow, and custom prompts for planning/coding/reviewing stages.","labels":["epic"],"sort_order":"bOw","status":"BACKLOG","title":"Code Reviews"},"created_at":"2026-08-31T11:14:52.736503Z","created_by":"claude-code/2.1.251 \u003cagent@mcp\u003e","on_behalf_of":"Nicolas Bettenburg \u003cnicbet@gmail.com\u003e","source":"mcp"}
