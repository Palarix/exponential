{"id":"xpo-9859c9","type":"CREATE","payload":{"description":"The new parent/un-parent mechanism we introduced for \"All Issues\" view in Backlog does not seem to be enabled or available for \"Active\" and \"Backlog\" views. That breaks user expected behaviour and is bad UX.","labels":["bug"],"sort_order":"bNi","title":"In Active and Backlog views I cannot parent/unparent with ALT"},"created_at":"2026-08-07T11:43:13.326757Z","created_by":"Nicolas Bettenburg \u003cnicbet@gmail.com\u003e","source":"web"}
